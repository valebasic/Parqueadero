# Configuración de PRODUCCIÓN. Copiar a ".env" (en esta misma carpeta) y completar.
# Reglas: una variable por línea, SIN comillas, sin espacios alrededor del "=".
# Este archivo ".env" NUNCA se sube a git (ya está en .gitignore).

# --- Dirección pública ---------------------------------------------------------------
# Con dominio:    SITE_ADDRESS=portal.midominio.com
# Sin dominio:    la IP del servidor con GUIONES + .sslip.io, p. ej. IP 203.0.113.10 -> 203-0-113-10.sslip.io
SITE_ADDRESS=
# Dirección completa con https:// (a ella apunta el QR de los tiquetes y los enlaces de los avisos)
PORTAL_URL=https://CAMBIAR
CORS_ORIGIN=https://CAMBIAR

# --- Base de datos (PostgreSQL 16 en Docker) -----------------------------------------
DB_USER=nexo
DB_NAME=nexo
# Clave larga y única. Generar con: openssl rand -base64 24
DB_PASSWORD=

# --- Seguridad -----------------------------------------------------------------------
# Mínimo 32 caracteres, distinto en cada instalación. Generar con: openssl rand -base64 48
JWT_SECRET=
# Contraseña inicial del usuario administrador "Felipe" (mínimo 8). Cambiarla tras el primer ingreso.
SEED_ADMIN_PASSWORD=
APP_TIMEZONE=America/Bogota
SESSION_MAX_HOURS=12

# --- Respaldos diarios (se guardan en deploy/backups) ---------------------------------
BACKUP_HOUR=2
BACKUP_KEEP=14

# --- NexoIA (asistente con Gemini) -----------------------------------------------------
GEMINI_API_KEY=

# --- Correo (comprobantes y avisos de mensualidad) -------------------------------------
# Gmail: contraseña de aplicación de 16 letras (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nexo.app <correo@gmail.com>
NOTIFY_HOUR=8
NOTIFY_UNTIL_HOUR=21

# --- SMS (opcional; la cuenta de prueba de Twilio no envía a clientes) -----------------
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DAILY_LIMIT=200

# --- Pago en línea con Wompi -----------------------------------------------------------
# VACÍO = el pago en línea queda APAGADO (el portal solo consulta y manda al parqueadero a pagar).
# Cuando haya cuenta de Wompi, llenar las cuatro llaves y volver a levantar: docker compose up -d
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
