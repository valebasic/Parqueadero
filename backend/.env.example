# Copiar a .env y completar. Nunca subir .env al repositorio.

# Entorno: development | test | production
NODE_ENV=development
# Puerto HTTP de la API
PORT=3000
# Orígenes permitidos para CORS, separados por coma (en desarrollo el frontend usa el proxy de Vite)
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL (se usa desde la Fase 2)
DATABASE_URL=postgres://nexo:CAMBIAR@localhost:5432/nexo
