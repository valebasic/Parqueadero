# Copiar a .env y completar. Nunca subir .env al repositorio.

# Entorno: development | test | production
NODE_ENV=development
# Puerto HTTP de la API
PORT=3000
# Orígenes permitidos para CORS, separados por coma (en desarrollo el frontend usa el proxy de Vite)
CORS_ORIGIN=http://localhost:5173
# Zona horaria de las sesiones de PostgreSQL
APP_TIMEZONE=America/Bogota

# --- PostgreSQL ---
# Los usa docker-compose.yml para crear el contenedor y la API para conectarse.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexo
DB_USER=nexo
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
# Base para las pruebas de integración (npm run test:db). Por defecto: <DB_NAME>_test
DB_NAME_TEST=nexo_test
# Opcional: si se define, reemplaza a los DB_* de arriba (p. ej. un PostgreSQL en la nube)
# DATABASE_URL=postgres://usuario:clave@servidor:5432/nexo
# TEST_DATABASE_URL=postgres://usuario:clave@servidor:5432/nexo_test

# --- Seguridad ---
# Secreto para firmar los JWT (mínimo 32 caracteres, distinto en cada instalación). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración máxima de una sesión en horas, aunque haya actividad (por defecto 12)
SESSION_MAX_HOURS=12
# Cookie de sesión solo por HTTPS. Por defecto: true en producción, false en desarrollo
# COOKIE_SECURE=true
# Si la API está detrás de un proxy inverso (nginx), número de proxies de confianza (p. ej. 1)
# TRUST_PROXY=1
# Límite de intentos de login por IP (por defecto 20 cada 15 minutos)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# --- Recibos ---
# Dirección del portal del cliente a la que apunta el QR del recibo (por ahora de ejemplo)
PORTAL_URL=https://portal.ejemplo.com

# --- Seed ---
# Contraseña inicial del usuario AG "Felipe" (mínimo 8 caracteres). Cambiarla tras el primer ingreso.
SEED_ADMIN_PASSWORD=
# Plano de Facaparking (zona Principal): 1 = crearlo si la zona no tiene plano (por defecto); 0 = omitirlo
SEED_SITE_MAP=1

# --- Respaldos (pg_dump) ---
# Carpeta de respaldos (por defecto backend/backups) y cuántos conservar
BACKUP_DIR=
BACKUP_KEEP=14
# Hora local (0-23) del respaldo diario; vacío = sin respaldo programado
BACKUP_HOUR=2
# Ruta de pg_dump 16 si no está en el PATH
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# Con PostgreSQL en Docker: ejecuta pg_dump dentro del contenedor
# PG_DUMP_DOCKER_CONTAINER=nexo-postgres

# --- NexoIA (asistente con Gemini) ---
# Clave de la API de Gemini (Google AI Studio). Vacía = NexoIA aparece como "no disponible".
GEMINI_API_KEY=
# Modelo (por defecto el de la v1.0)
GEMINI_MODEL=gemini-3.5-flash-lite
# Preguntas por usuario (por defecto 30 cada 15 minutos)
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MIN=15

# --- Portal del cliente: pago con Wompi ---
# Sin estas llaves el portal usa un pago SIMULADO (solo para pruebas, nunca en producción).
# Cuenta gratis: https://comercios.wompi.co  → Desarrolladores → llaves del ambiente de pruebas (sandbox).
# WOMPI_ENV=sandbox
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_INTEGRITY_SECRET=test_integrity_...
# WOMPI_EVENTS_SECRET=test_events_...
# Minutos que tiene el cliente para salir sin cobro adicional después de pagar (por defecto 10)
PORTAL_EXIT_WINDOW_MIN=10
# Límite de consultas del portal por IP (por defecto 60 cada 15 min) y de intentos de pago (15)
# PORTAL_RATE_LIMIT_MAX=60
# PORTAL_PAY_RATE_LIMIT_MAX=15

# --- Correo (comprobantes y avisos de mensualidad) ---
# Sin SMTP el correo se SIMULA: en desarrollo se imprime en la consola del servidor.
# Gmail (gratis): activar la verificación en 2 pasos y crear una "contraseña de aplicación" en
#   https://myaccount.google.com/apppasswords  (16 letras; NO es la contraseña normal de Gmail).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=su.correo@gmail.com
# SMTP_PASS=contraseña_de_aplicación
# MAIL_FROM=Nexo.app <su.correo@gmail.com>
# Avisos de mensualidad (6, 3 y 1 días antes, y vencida): se revisan al arrancar y cada hora, y solo se
# envían entre NOTIFY_HOUR y NOTIFY_UNTIL_HOUR, hora de Colombia (por defecto de 8 a 21)
# NOTIFY_HOUR=8
# NOTIFY_UNTIL_HOUR=21

# --- SMS (códigos y avisos de mensualidad) ---
# Sin estas variables el SMS se SIMULA: en desarrollo se imprime en la consola del servidor.
# Twilio: https://console.twilio.com  (la cuenta de prueba solo envía a números verificados allí).
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15551234567        # o el SID de un Messaging Service (MG...)
# Tope de SMS por día para no gastar de más (por defecto 200)
# SMS_DAILY_LIMIT=200
