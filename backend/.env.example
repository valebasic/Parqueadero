# Copiar a .env y completar. Nunca subir .env al repositorio.

# Entorno: development | test | production
NODE_ENV=development
# Puerto HTTP de la API
PORT=3000
# Orígenes permitidos para CORS, separados por coma (en desarrollo el frontend usa el proxy de Vite)
CORS_ORIGIN=http://localhost:5173
# Zona horaria de las sesiones de PostgreSQL
APP_TIMEZONE=America/Bogota

# --- PostgreSQL ---
# Los usa docker-compose.yml para crear el contenedor y la API para conectarse.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexo
DB_USER=nexo
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
# Base para las pruebas de integración (npm run test:db). Por defecto: <DB_NAME>_test
DB_NAME_TEST=nexo_test
# Opcional: si se define, reemplaza a los DB_* de arriba (p. ej. un PostgreSQL en la nube)
# DATABASE_URL=postgres://usuario:clave@servidor:5432/nexo
# TEST_DATABASE_URL=postgres://usuario:clave@servidor:5432/nexo_test

# --- Seguridad ---
# Secreto para firmar los JWT (mínimo 32 caracteres, distinto en cada instalación). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración máxima de una sesión en horas, aunque haya actividad (por defecto 12)
SESSION_MAX_HOURS=12
# Cookie de sesión solo por HTTPS. Por defecto: true en producción, false en desarrollo
# COOKIE_SECURE=true
# Si la API está detrás de un proxy inverso (nginx), número de proxies de confianza (p. ej. 1)
# TRUST_PROXY=1
# Límite de intentos de login por IP (por defecto 20 cada 15 minutos)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# --- Recibos ---
# Dirección del portal del cliente a la que apunta el QR del recibo (por ahora de ejemplo)
PORTAL_URL=https://portal.ejemplo.com

# --- Seed ---
# Contraseña inicial del usuario AG "Felipe" (mínimo 8 caracteres). Cambiarla tras el primer ingreso.
SEED_ADMIN_PASSWORD=
# Plano de Facaparking (zona Principal): 1 = crearlo si la zona no tiene plano (por defecto); 0 = omitirlo
SEED_SITE_MAP=1

# --- Respaldos (pg_dump) ---
# Carpeta de respaldos (por defecto backend/backups) y cuántos conservar
BACKUP_DIR=
BACKUP_KEEP=14
# Hora local (0-23) del respaldo diario; vacío = sin respaldo programado
BACKUP_HOUR=2
# Ruta de pg_dump 16 si no está en el PATH
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# Con PostgreSQL en Docker: ejecuta pg_dump dentro del contenedor
# PG_DUMP_DOCKER_CONTAINER=nexo-postgres

# --- NexoIA (asistente con Gemini) ---
# Clave de la API de Gemini (Google AI Studio). Vacía = NexoIA aparece como "no disponible".
GEMINI_API_KEY=
# Modelo (por defecto el de la v1.0)
GEMINI_MODEL=gemini-3.5-flash-lite
# Preguntas por usuario (por defecto 30 cada 15 minutos)
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MIN=15
