{
  "name": "nexo-backend",
  "version": "2.0.0",
  "description": "API REST de Nexo App v2.0 (parqueadero Facaparking)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:db": "jest -c jest.db.config.js --runInBand",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node src/db/migrate.js up",
    "db:migrate:down": "node src/db/migrate.js down",
    "db:migrate:create": "node-pg-migrate create -m src/db/migrations -j sql",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js"
  },
  "author": "Santiago Suarez",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.11"
  }
}
